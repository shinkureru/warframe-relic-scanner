{
  "name": "warframe-relic-scanner",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"node server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "deploy:worker": "wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^6.0.1",
    "@paddleocr/paddleocr-js": "^0.4.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "sass": "^1.83.4",
    "vite": "^6.0.7",
    "wrangler": "^4.0.0"
  }
}
